{
  "modify": [
    // Fix the position of entities associated with the weapon after AG2 updates
    {
      "match": {
        "classname": "env_entity_maker",
        "targetname": "[PR#]creaer_tierra1"
      },
      "replace": {
        "origin": "46.500000 -1.320068 -2.750000"
      }
    },
    {
      "match": {
        "classname": "func_button",
        "targetname": "[PR#]magia_tierra_button"
      },
      "replace": {
        "origin": "38.000000 -0.320068 5.000000"
      }
    },
    {
      "match": {
        "classname": "info_particle_system",
        "targetname": "[PR#]tierra_f"
      },
      "replace": {
        "origin": "39.900391 -0.460083 2.679932"
      }
    }
  ]
}